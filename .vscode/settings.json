{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.action.useSortedKeys.biome": "explicit",
    "source.fixAll.biome": "explicit"
  },
  "[json][jsonc][javascript][javascriptreact][typescript][typescriptreact][css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "biome.suggestInstallingGlobally": false,
  "redhat.telemetry.enabled": false,
  "json.schemaDownload.trustedDomains": {
    "https://biomejs.dev": true,
    "https://docs.renovatebot.com/renovate-schema.json": true,
    "https://gitlab.com/gitlab-org/gitlab/-/raw/master/app/assets/javascripts/editor/schema/ci.json": true,
    "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json": true
  }
}
